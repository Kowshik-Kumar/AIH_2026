# ── MentorSphere Backend — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── ML / Embedding ─────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_MENTORS=4

# ── Data Paths ─────────────────────────────────────────────────────────────────
MENTORS_DATA_PATH=data/mentors.json
SKILLS_DATA_PATH=data/skills.json
LEARNING_PATHS_DATA_PATH=data/learning_paths.json
RESOURCES_DATA_PATH=data/resources.json

# ── FAISS Index Paths ──────────────────────────────────────────────────────────
MENTOR_INDEX_PATH=models/embeddings/mentor_index.faiss
MENTOR_RECORDS_PATH=models/embeddings/mentor_records.json

# ── Supabase (future) ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ── Google Gemini (future) ─────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
